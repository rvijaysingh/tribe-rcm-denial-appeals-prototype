# Anthropic API key used by the denial-appeal LLM pipeline
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Voyage AI key used for embedding payer policy text into pgvector
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Postgres (pgvector) connection string; Railway provides this in production
DATABASE_URL=postgresql://user:password@localhost:5432/denial_appeals

# Sampling temperature, 0 to 1. Default 0 for run-to-run stability.
# Inert on claude-sonnet-5 and claude-opus-5: those models removed sampling
# and reject the parameter with a 400, so it is not sent to them.
LLM_TEMPERATURE=0
